    },
    "Your identity is a key that only you hold. It can be restored — but never recreated." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Identität ist ein Schlüssel, den nur du besitzt. Sie kann wiederhergestellt werden – aber nie neu erfunden."
