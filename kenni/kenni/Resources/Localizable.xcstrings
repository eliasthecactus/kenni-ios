    "Something feels off? Tap the contact in KENNI. Their phone asks them to confirm — with a signature only their device can create." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas fühlt sich falsch an? Tippe in KENNI auf den Kontakt. Das Handy der Person bittet sie zu bestätigen – mit einer Signatur, die nur ihr Gerät erzeugen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Algo no cuadra? Toca el contacto en KENNI. Su teléfono le pedirá confirmar — con una firma que solo su dispositivo puede crear."
          }
        }
      }
    },
    "Something went wrong" : {
      "extractionState" : "stale",
