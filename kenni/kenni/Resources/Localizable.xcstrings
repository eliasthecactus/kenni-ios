      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Schlüssel wird Ende-zu-Ende-verschlüsselt in deinem persönlichen iCloud-Schlüsselbund gespeichert. Verlierst du dieses Handy, stellt ein neues iPhone ihn automatisch wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave se guarda cifrada de extremo a extremo en tu llavero de iCloud personal. Si pierdes este teléfono, un iPhone nuevo la restaura automáticamente."
