        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido de nuevo"
          }
        }
      }
    },
    "When someone checks if it's really you — on a call, in a chat, anywhere — your phone must be able to tell you instantly." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn jemand prüft, ob wirklich du es bist – am Telefon, im Chat, überall – muss dein Handy es dir sofort sagen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando alguien comprueba si de verdad eres tú — en una llamada, en un chat, donde sea — tu teléfono debe poder avisarte al instante."
          }
        }
      }
    },
    "Which is word #%d?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches ist Wort Nr. %d?"
